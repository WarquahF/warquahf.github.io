---
import { sections, social } from '../data/nav';

const isHome = Astro.url.pathname === '/';
const onNotes = Astro.url.pathname.startsWith('/notes');
const linkFor = (href: string) =>
  !isHome && href.startsWith('#') ? `/${href}` : href;
---

<header class="nav">
  <a class="nav-mark mono" href={linkFor('#home')} aria-label="Home">
    <span class="nav-mark-box">W</span>
    <span class="nav-mark-name">WARQUAH FAIZ</span>
  </a>

  <nav class="nav-links mono" aria-label="Primary">
    {sections.slice(1).map((s) => (
      <a
        href={linkFor(s.href)}
        data-spy={s.href.startsWith('#') ? s.href.slice(1) : undefined}
        aria-current={onNotes && s.href === '/notes' ? 'page' : undefined}
      >
        {s.label}
      </a>
    ))}
  </nav>

  <div class="nav-right">
    <a class="nav-github mono" href={social.github} target="_blank" rel="noreferrer">
      github.com/WarquahF
    </a>
    <button class="nav-kbd mono" type="button" data-command-trigger aria-label="Open command palette">
      <span>⌘</span>K
    </button>
    <button class="nav-theme" type="button" data-theme-toggle aria-label="Toggle color theme">
      <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      <svg class="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const meta = document.querySelector('meta[name="theme-color"]');
  const paintMeta = () => {
    meta?.setAttribute('content', root.dataset.theme === 'dark' ? '#101012' : '#faf8f3');
  };
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('wf-theme', next);
      } catch {
        /* private mode: theme just won't persist */
      }
      paintMeta();
    });
  });
  paintMeta();

  // Scrollspy: one IntersectionObserver marks the in-view section's link.
  // Restrained by design — ink text + quiet highlight, no bright colors.
  const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-links a[data-spy]'));
  const spyTargets = spyLinks
    .map((link) => {
      const el = link.dataset.spy ? document.getElementById(link.dataset.spy) : null;
      return el ? { link, el } : null;
    })
    .filter((v): v is { link: HTMLAnchorElement; el: HTMLElement } => v !== null);

  if (spyTargets.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const match = spyTargets.find((t) => t.el === entry.target);
          if (!match || !entry.isIntersecting) return;
          spyTargets.forEach((t) => {
            if (t === match) {
              t.link.setAttribute('aria-current', 'true');
            } else {
              t.link.removeAttribute('aria-current');
            }
          });
        });
      },
      { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
    );
    spyTargets.forEach((t) => spy.observe(t.el));
  }
</script>

<style>
  /* Floating hardware pill: 1px outline, glass fill, inner top light.
     Separated from the page at all scroll positions — never dissolves. */
  .nav {
    position: sticky;
    top: 0.75rem;
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: min(var(--wide-w), calc(100% - 1.5rem));
    margin: 0.75rem auto 0;
    padding: 0.55rem 0.6rem 0.55rem 0.9rem;
    /* Visible outline in BOTH themes: light gets a warm hairline, dark a
       brighter glass edge. Text colors track the theme via --ink vars with a
       smooth transition (see .nav-links / .nav-github / .nav-kbd below). */
    border: 1px solid color-mix(in srgb, var(--ink) 32%, var(--line-strong));
    border-radius: 14px;
    background: color-mix(in srgb, var(--bg-raised) 74%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      0 0 0 0.5px color-mix(in srgb, var(--ink) 12%, transparent),
      0 10px 28px rgba(28, 25, 18, 0.09);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  [data-theme='dark'] .nav {
    border-color: color-mix(in srgb, var(--ink) 30%, var(--line-strong));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 0 0 0.5px color-mix(in srgb, var(--ink) 16%, transparent),
      0 10px 28px rgba(0, 0, 0, 0.35);
  }

  .nav-links a,
  .nav-mark-name,
  .nav-github,
  .nav-kbd,
  .nav-theme {
    transition:
      color 0.35s ease,
      opacity 0.35s ease,
      border-color 0.35s ease;
  }
  /* theme-aware text strength inside the glass bar */
  [data-theme='light'] .nav { color: var(--ink); }
  [data-theme='dark'] .nav { color: var(--ink); }
  [data-theme='light'] .nav-links a { color: var(--ink-dim); }
  [data-theme='dark'] .nav-links a { color: var(--ink-dim); }
  .nav-links a[data-active='true'] { color: var(--ink); }

  .nav.is-solid {
    background: color-mix(in srgb, var(--bg-raised) 88%, transparent);
    border-color: var(--line-strong);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.55),
      0 14px 34px rgba(28, 25, 18, 0.12);
  }

  .nav-mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    transition: opacity 0.2s var(--ease-out);
    flex: none;
  }

  .nav-mark:hover {
    opacity: 0.8;
  }

  /* Brand mark: flat bordered W. No gradients, no sheen — the mark stays
     quiet and recognizable. */
  .nav-mark-box {
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 7px;
    color: var(--signal);
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--bg-raised);
  }

  .nav-mark-name {
    display: none;
  }

  @media (min-width: 560px) {
    .nav-mark-name {
      display: inline;
    }
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 0.15rem;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--ink-faint);
    padding: 0.32rem 0.65rem;
    border-radius: 8px;
    transition:
      color 0.2s var(--ease-out),
      background-color 0.25s var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 5%, transparent);
  }

  /* Active section: dark text + quiet glass/highlight state. */
  .nav-links a[aria-current='true'],
  .nav-links a[aria-current='page'] {
    color: var(--ink);
    background: var(--signal-ghost);
  }

  @media (min-width: 780px) {
    .nav-links {
      display: flex;
    }
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: none;
  }

  .nav-github {
    display: none;
    font-size: var(--step--1);
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.2s var(--ease-out);
  }

  .nav-github:hover {
    color: var(--ink);
  }

  @media (min-width: 960px) {
    .nav-github {
      display: inline;
    }
  }

  .nav-kbd {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    font-size: var(--step--2);
    color: var(--ink-faint);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 0.25rem 0.5rem;
    background: color-mix(in srgb, var(--bg-raised) 60%, transparent);
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .nav-kbd:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .nav-theme {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    color: var(--ink-faint);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-raised) 60%, transparent);
    transition: border-color 0.2s var(--ease-out), color 0.2s var(--ease-out);
  }

  .nav-theme:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .nav-theme .icon-sun {
    display: none;
  }

  [data-theme='dark'] .nav-theme .icon-sun {
    display: block;
  }

  [data-theme='dark'] .nav-theme .icon-moon {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav { transition: none; }
  }

  @media print {
    .nav { display: none; }
  }
</style>
