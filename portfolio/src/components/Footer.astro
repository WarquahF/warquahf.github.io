---
import { social } from '../data/nav';
const now = new Date();
const year = now.getFullYear();
// Build-time date = last deployed update. Automatic — no manual upkeep.
const updated = now.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const homeHref = Astro.url.pathname === '/' ? '#home' : '/#home';
---

<footer class="footer mono">
  <div class="mega" aria-hidden="true">Warquah</div>
  <div class="footer-row">
    <p>Warquah Faiz © {year} · Updated {updated} — Designed and built by Warquah Faiz.</p>
    <div class="footer-links">
      <a href={social.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={social.x} target="_blank" rel="noreferrer">X</a>
      <a href={`mailto:${social.email}`}>Email</a>
      <a href={homeHref}>Back to top ↑</a>
    </div>
  </div>
  <p class="footer-signoff">alright bro you actually read the whole thing?? say hi then 👋</p>
</footer>

<style>
  .footer {
    padding: 0 clamp(1.25rem, 5vw, 3.5rem) var(--space-2xl);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .mega {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.04;
    font-size: clamp(3.5rem, 18vw, 15rem);
    color: var(--ink);
    border-top: 1px solid var(--line);
    padding-top: var(--space-xl);
    padding-bottom: 0.08em;
    white-space: nowrap;
    overflow: hidden;
    user-select: none;
  }

  .footer-row {
    margin-top: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .footer-signoff {
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }

  .footer-links {
    display: flex;
    gap: 1rem;
  }

  .footer-links a {
    text-decoration: none;
    color: var(--ink-faint);
    transition: color 0.2s var(--ease-out);
  }

  .footer-links a:hover {
    color: var(--link);
  }
</style>
