---
import { projects, archive } from '../data/projects';

const profileUrl = 'https://github.com/WarquahF';
const viewUrl = (href?: string) => href ?? profileUrl;

// File trees are lightweight editorial representations drawn only from the
// existing portfolio copy — folder names reflect documented concepts.
const trees: Record<string, { name: string; kind: 'dir' | 'file'; note?: string }[]> = {
  blink: [
    { name: 'src/', kind: 'dir', note: 'interface' },
    { name: 'src-tauri/', kind: 'dir', note: 'router · Rust' },
    { name: 'storage/', kind: 'dir', note: 'SQLite · encrypted' },
    { name: 'docs/', kind: 'dir' },
    { name: 'README.md', kind: 'file', note: 'local-first' },
  ],
  'zest-tty': [
    { name: 'src/', kind: 'dir', note: 'parser · IR · emitter' },
    { name: 'tests/', kind: 'dir', note: 'canonical gate' },
    { name: 'docs/', kind: 'dir', note: 'supported subset' },
    { name: 'README.md', kind: 'file', note: 'deterministic' },
  ],
  nugget: [
    { name: 'main/', kind: 'dir', note: 'Electron shell' },
    { name: 'renderer/', kind: 'dir', note: 'client UI' },
    { name: 'voice/', kind: 'dir', note: 'interaction' },
    { name: 'README.md', kind: 'file', note: 'proving ground' },
  ],
};
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="section-inner">
    <p class="eyebrow"><span class="path">/work</span></p>
    <h2 class="work-title" id="work-title" data-entrance>Three projects. One standard.</h2>
    <p class="work-lede" data-reveal>Desktop software and developer tooling — each one you can open, read, and run. Select a project to read more.</p>

    <div class="work-list">
      {projects.map((p, i) => (
        <article class="project" data-project={p.slug} data-active={i === 0 ? 'true' : 'false'}>
          <div class="project-main">
            <div class="project-copy">
              <p class="project-meta mono">
                <span>{String(i + 1).padStart(2, '0')}</span>
                <span class="project-kind">{p.kind}</span>
              </p>
              <h3 class="project-name">
                <button
                  type="button"
                  class="project-toggle"
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`detail-${p.slug}`}
                  data-toggle={p.slug}
                >
                  <span>{p.name}</span>
                  <span class="toggle-mark" aria-hidden="true"></span>
                </button>
              </h3>
              <p class="project-summary">{p.summary}</p>
              <a class="view-link" href={viewUrl(p.href)} target="_blank" rel="noreferrer">
                View Project <span class="link-arrow" aria-hidden="true">→</span>
              </a>

              <div
                class="project-detail"
                id={`detail-${p.slug}`}
                data-detail={p.slug}
                inert={i === 0 ? undefined : true}
              >
                <div class="project-detail-inner">
                  <p class="project-detail-text">{p.detail}</p>
                  <ul class="project-points">
                    {p.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                  <div class="project-stack mono" aria-label="Technologies">
                    {p.stack.map((s) => <span>{s}</span>)}
                  </div>
                  <a class="view-link view-link-detail" href={viewUrl(p.href)} target="_blank" rel="noreferrer">
                    View Project <span class="link-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </div>

            <div class="project-visual" data-visual={p.slug}>
              <div class="repo" aria-hidden="true">
                <div class="repo-head">
                  <span class="repo-dots"><i></i><i></i><i></i></span>
                  <span class="repo-url mono">github.com/WarquahF/{p.slug}</span>
                  <span class="repo-badge mono">Public</span>
                </div>
                <div class="repo-nav mono">
                  <span class="is-on">Code</span><span>Issues</span><span>Pull requests</span>
                </div>
                <div class="repo-body">
                  <div class="repo-files mono">
                    {(trees[p.slug] ?? [{ name: 'README.md', kind: 'file' }]).map((f) => (
                      <span class="repo-file">
                        <span class={f.kind === 'dir' ? 'file-ic file-dir' : 'file-ic file-doc'}></span>
                        <span>{f.name}</span>
                        {f.note && <span class="repo-note">{f.note}</span>}
                      </span>
                    ))}
                  </div>

                  {p.slug === 'blink' && (
                    <div class="repo-diagram">
                      <span class="rd-node">Your prompt</span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-node rd-strong">Provider router · Rust</span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-branch">
                        <span class="rd-node rd-small">OpenRouter</span>
                        <span class="rd-node rd-small">Ollama · local</span>
                      </span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-node">Response</span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-node rd-quiet">Encrypted SQLite log</span>
                    </div>
                  )}

                  {p.slug === 'zest-tty' && (
                    <div class="repo-diagram repo-diagram-pipeline">
                      <span class="rd-kicker mono">SOURCE → ODIN</span>
                      <span class="rd-node rd-strong">SOURCE</span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-node">UNDERSTAND</span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-node">TRANSLATE</span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-node">VALIDATE</span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-node rd-strong">ODIN</span>
                    </div>
                  )}

                  {p.slug === 'nugget' && (
                    <div class="repo-diagram">
                      <span class="rd-branch">
                        <span class="rd-node rd-small">Text input</span>
                        <span class="rd-node rd-small">Voice input</span>
                      </span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-node rd-strong">Electron shell</span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-node">AI service</span>
                      <span class="rd-arrow">↓</span>
                      <span class="rd-node rd-quiet">Desktop response</span>
                    </div>
                  )}

                  <div class="repo-readme">
                    <p class="repo-readme-title mono">README.md</p>
                    <p class="repo-readme-text">{p.summary}</p>
                  </div>
                </div>
                <div class="repo-foot mono">
                  <span>main</span><span>{p.stack.slice(0, 3).join(' · ')}</span>
                </div>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="archive">
      <p class="eyebrow" style="margin-bottom: 0.5rem;"><span class="path">/archive</span></p>
      <ul class="archive-list mono">
        {archive.map((a, i) => (
          <li><span class="archive-index">{String(i + 1).padStart(2, '0')}</span>{a.name}<span class="archive-note">{a.note}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Single-active editorial viewer + restrained cursor lift.
  // No libraries: class flips + CSS transitions, one rAF per gesture.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(pointer: fine)').matches;

  const cards = Array.from(document.querySelectorAll<HTMLElement>('.project'));

  const setActive = (slug: string | null) => {
    cards.forEach((card) => {
      const isOn = slug !== null && card.dataset.project === slug;
      card.setAttribute('data-active', isOn ? 'true' : 'false');
      const btn = card.querySelector<HTMLButtonElement>('[data-toggle]');
      if (btn) btn.setAttribute('aria-expanded', isOn ? 'true' : 'false');
      // Keep collapsed details out of the tab order: content is duplicated
      // by the always-visible summary + View Project link above.
      const detail = card.querySelector<HTMLElement>('[data-detail]');
      if (detail) {
        if (isOn) {
          detail.removeAttribute('inert');
        } else {
          detail.setAttribute('inert', '');
        }
      }
    });
  };

  // Initialize inert state to match the server-rendered active card.

  cards.forEach((card) => {
    const slug = card.dataset.project ?? '';
    const btn = card.querySelector<HTMLButtonElement>('[data-toggle]');
    const detail = card.querySelector<HTMLElement>('[data-detail]');
    // Server renders the first project open; mirror that for AT + keyboard.
    if (detail && card.getAttribute('data-active') !== 'true') {
      detail.setAttribute('inert', '');
    }
    btn?.addEventListener('click', () => {
      const currently = card.getAttribute('data-active') === 'true';
      // Only one expanded at a time; clicking the open one collapses it.
      setActive(currently ? null : slug);
    });
  });

  // Cursor-reactive lift: slight rise + tiny parallax, springs home.
  // Disabled for touch + reduced motion. Content never depends on hover.
  if (!reduceMotion && finePointer) {
    document.querySelectorAll<HTMLElement>('.project-visual').forEach((zone) => {
      const repo = zone.querySelector<HTMLElement>('.repo');
      if (!repo) return;
      let raf = 0;
      let tx = 0;
      let ty = 0;

      const paint = () => {
        raf = 0;
        repo.style.transform = `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0) scale(1.015)`;
      };

      zone.addEventListener('pointermove', (e) => {
        const r = zone.getBoundingClientRect();
        const px = (e.clientX - r.left) / Math.max(1, r.width) - 0.5;
        const py = (e.clientY - r.top) / Math.max(1, r.height) - 0.5;
        // Restrained: max ±7px lateral, gentle upward bias.
        tx = Math.max(-7, Math.min(7, px * 14));
        ty = Math.max(-10, Math.min(4, py * 10 - 5));
        repo.style.transition = 'transform 0.18s ease-out';
        if (!raf) raf = requestAnimationFrame(paint);
      });

      zone.addEventListener('pointerleave', () => {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        repo.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
        repo.style.transform = 'translate3d(0, 0, 0) scale(1)';
      });
    });
  }
</script>

<style>
  .work-title { max-width: 18ch; }
  .work-lede { margin-top: var(--space-sm); max-width: 52ch; }

  .work-list {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
  }

  /* Editorial viewer: text column + protruding repo visual. Alternating
     sides give the asymmetry; geometry is a plain offset, no 3D. */
  .project {
    padding: clamp(2.75rem, 6vw, 4.75rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .project-main {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }

  .project:nth-child(even) .project-copy { order: 2; }
  .project:nth-child(even) .project-visual { order: 1; }

  .project-meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    margin: 0 0 var(--space-md);
  }

  .project-kind { margin-left: auto; text-align: right; }

  .project-name { margin: 0; font-size: clamp(2.4rem, 5.5vw, 4rem); letter-spacing: -0.032em; line-height: 0.98; }

  .project-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0;
    font: inherit;
    color: var(--ink);
    letter-spacing: inherit;
    text-align: left;
    border-radius: var(--radius-sm);
  }

  .toggle-mark {
    position: relative;
    width: 1.7rem;
    height: 1.7rem;
    flex: none;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: transform 0.35s var(--ease), border-color 0.25s ease, background-color 0.25s ease;
  }

  .toggle-mark::before,
  .toggle-mark::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    background: var(--ink-dim);
    transition: transform 0.35s var(--ease), opacity 0.25s ease;
  }

  .toggle-mark::before { width: 9px; height: 1.4px; transform: translate(-50%, -50%); }
  .toggle-mark::after { width: 1.4px; height: 9px; transform: translate(-50%, -50%); }

  .project[data-active='true'] .toggle-mark { transform: rotate(135deg); border-color: var(--ink); }
  .project-toggle:hover .toggle-mark { border-color: var(--ink); }

  .project-summary {
    margin-top: var(--space-md);
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink);
    max-width: 34ch;
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-md);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s ease, opacity 0.2s ease;
  }

  .view-link:hover { text-decoration-color: var(--ink); opacity: 0.85; }

  /* Expandable detail: smooth grid-rows transition, not an accordion card.
     Collapsed panels are visibility-hidden (with inert in JS) so keyboard
     users never tab into hidden View Project duplicates. */
  .project-detail {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition: grid-template-rows 0.55s var(--ease), opacity 0.45s ease, margin 0.45s var(--ease), visibility 0s linear 0.55s;
    margin-top: 0;
  }

  .project[data-active='true'] .project-detail {
    grid-template-rows: 1fr;
    opacity: 1;
    visibility: visible;
    transition: grid-template-rows 0.55s var(--ease), opacity 0.45s ease, margin 0.45s var(--ease), visibility 0s;
    margin-top: var(--space-lg);
  }

  .project-detail-inner {
    overflow: hidden;
    min-height: 0;
    border-top: 1px solid transparent;
  }

  .project[data-active='true'] .project-detail-inner {
    border-top-color: var(--line);
    padding-top: var(--space-lg);
  }

  .project-detail-text { margin: 0; line-height: 1.65; max-width: 52ch; }

  .project-points {
    margin-top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .project-points li {
    position: relative;
    padding-left: 1rem;
    color: var(--ink-dim);
    font-size: var(--step-0);
    line-height: 1.55;
    max-width: 52ch;
  }

  .project-points li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--ink-faint);
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: var(--space-md);
  }

  .project-stack span {
    font-size: var(--step--2);
    color: var(--ink-faint);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.55rem;
    letter-spacing: 0.02em;
  }

  .view-link-detail { margin-top: var(--space-lg); }

  /* ---- Repo-style visual: lightweight imagery, monochrome, warm -------- */

  .project-visual {
    position: relative;
    min-width: 0;
    padding-top: 0.6rem;
  }

  .repo {
    background: var(--bg-raised);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 18px 44px rgba(28, 25, 18, 0.08);
    will-change: transform;
    /* Asymmetric protrusion: the frame escapes the text column to the
       outer edge. Even rows mirror to the opposite edge. */
    margin-right: clamp(-3.5rem, -4vw, -1rem);
  }

  .project:nth-child(even) .repo {
    margin-right: 0;
    margin-left: clamp(-3.5rem, -4vw, -1rem);
  }

  .repo-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 55%, var(--bg-raised));
  }

  .repo-dots { display: inline-flex; gap: 5px; }
  .repo-dots i {
    width: 8px; height: 8px; border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    display: block;
  }

  .repo-url { font-size: 0.72rem; color: var(--ink-dim); letter-spacing: 0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .repo-badge {
    margin-left: auto;
    font-size: 0.66rem;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    flex: none;
  }

  .repo-nav {
    display: flex;
    gap: 1rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.7rem;
    color: var(--ink-faint);
  }

  .repo-nav .is-on { color: var(--ink); font-weight: 600; border-bottom: 1px solid var(--ink); padding-bottom: 0.1rem; }

  .repo-body { padding: 0.9rem; display: flex; flex-direction: column; gap: 0.9rem; }

  .repo-files {
    border: 1px solid var(--line);
    border-radius: 7px;
    overflow: hidden;
  }

  .repo-file {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.65rem;
    font-size: 0.72rem;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line);
    background: var(--bg-raised);
  }

  .repo-file:last-child { border-bottom: none; }

  .file-ic { width: 11px; height: 11px; flex: none; border: 1px solid var(--line-strong); }
  .file-dir { border-radius: 2px 5px 2px 2px; background: var(--bg-sunken); }
  .file-doc { border-radius: 2px; background: var(--bg); }

  .repo-note { margin-left: auto; color: var(--ink-faint); font-size: 0.66rem; }

  .repo-diagram {
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--bg);
    padding: 0.9rem 0.7rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .rd-kicker { font-size: 0.64rem; letter-spacing: 0.12em; color: var(--ink-faint); margin-bottom: 0.3rem; }

  .rd-node {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink);
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
    border-radius: 5px;
    padding: 0.35rem 0.65rem;
    white-space: nowrap;
    max-width: 100%;
  }

  .rd-strong { font-weight: 700; border-color: var(--ink-faint); }
  .rd-small { font-size: 0.66rem; }
  .rd-quiet { color: var(--ink-dim); }

  .repo-diagram-pipeline .rd-node { min-width: 11rem; text-align: center; letter-spacing: 0.06em; }

  .rd-branch { display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: center; }
  .rd-arrow { color: var(--ink-faint); font-size: 0.8rem; line-height: 1; }

  .repo-readme {
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 0.7rem 0.8rem;
    background: var(--bg-raised);
  }

  .repo-readme-title { margin: 0; font-size: 0.66rem; letter-spacing: 0.08em; color: var(--ink-faint); }
  .repo-readme-text { margin: 0.35rem 0 0; font-size: 0.8rem; line-height: 1.55; color: var(--ink-dim); max-width: 100%; }

  .repo-foot {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.66rem;
    color: var(--ink-faint);
    background: color-mix(in srgb, var(--bg) 55%, var(--bg-raised));
  }

  .archive { margin-top: var(--space-2xl); }
  .archive-list { border-top: 1px solid var(--line); }
  .archive-list li {
    display: flex; gap: 0.75rem; align-items: baseline;
    padding: 0.6rem 0; border-bottom: 1px solid var(--line);
    font-size: var(--step--1); color: var(--ink-dim);
  }
  .archive-index { color: var(--ink-faint); }
  .archive-note { margin-left: auto; color: var(--ink-faint); }

  /* Intentional mobile design: visual becomes a full-width sheet below
     the copy, without outer protrusion or horizontal overflow. */
  @media (max-width: 900px) {
    .project-main { grid-template-columns: 1fr; }
    .project:nth-child(even) .project-copy { order: 1; }
    .project:nth-child(even) .project-visual { order: 2; }
    .repo,
    .project:nth-child(even) .repo { margin: 0; }
    .project-kind { margin-left: 0; }
    .project-meta { flex-wrap: wrap; }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-detail { transition: none; }
    .repo { box-shadow: none; }
  }
</style>
