---
import { social } from '../data/nav';
import { existsSync } from 'node:fs';

// Optional profile photo: drop ONE file at `public/profile.jpg`
// (.jpg / .jpeg / .png / .webp / .avif all work). If no file exists,
// no avatar renders at all — add, swap or delete the file anytime to
// control the DP without touching code.
const profileCandidates = ['profile.jpg', 'profile.jpeg', 'profile.png', 'profile.webp', 'profile.avif'];
const publicDir = new URL('../../public/', import.meta.url);
const profileFile = profileCandidates.find((f) => {
  try {
    return existsSync(new URL(f, publicDir));
  } catch {
    return false;
  }
});
const profileSrc = profileFile ? `/${profileFile}` : null;

// Rotating phrases are grounded in existing work only — no invented claims.
const rotating = [
  'local-first desktop software',
  'developer tools that explain themselves',
  'deterministic transpiler pipelines',
  'fast, private, simple systems',
];

const socials = [
  {
    label: 'Email Warquah Faiz via Gmail',
    href: `mailto:${social.email}`,
    key: 'gmail',
    text: 'Gmail',
  },
  {
    label: 'Warquah Faiz on GitHub',
    href: social.github,
    key: 'github',
    text: 'GitHub',
  },
  {
    label: 'Warquah Faiz on LinkedIn',
    href: social.linkedin,
    key: 'linkedin',
    text: 'LinkedIn',
  },
  {
    label: 'Warquah Faiz on X',
    href: social.x,
    key: 'x',
    text: 'X',
  },
].filter((s) => Boolean(s.href));
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-atmos" aria-hidden="true">
    <span class="atmos-a"></span>
    <span class="atmos-b"></span>
  </div>
  <div class="hero-inner">
    <div class="hero-identity" data-fade-late>
      {profileSrc && (
        <img
          class="hero-avatar-img"
          src={profileSrc}
          alt="Portrait of Warquah Faiz"
          width="112"
          height="112"
        />
      )}
      <div class="hero-who">
        <p class="hero-name">Warquah Faiz</p>
        <p class="hero-place mono">Odisha, India · Open to projects</p>
      </div>
    </div>

    <h1 class="hero-title" id="hero-title" data-entrance>
      Software that respects your machine.
    </h1>

    <p class="hero-permanent" data-fade-late>
      I build desktop software and developer tools — local-first, fast,
      and simple. The work below is where that thinking currently lives.
    </p>

    <p class="hero-rotating" data-fade-late>
      <span class="hero-rotating-label">Focused on</span>
      <span
        class="rotator"
        role="status"
        aria-live="polite"
        aria-label={`Currently focused on: ${rotating[0]}`}
        data-rotator
        data-phrases={JSON.stringify(rotating)}
      >
        {rotating.map((phrase, i) => (
          <span class="rotator-phrase" data-active={i === 0 ? 'true' : 'false'} aria-hidden={i === 0 ? 'false' : 'true'}>
            {phrase}
          </span>
        ))}
      </span>
    </p>

    <div class="hero-social" data-fade-late>
      {socials.map((s) => (
        <a class="social-link" href={s.href} target={s.key === 'gmail' ? undefined : '_blank'} rel={s.key === 'gmail' ? undefined : 'noreferrer'} aria-label={s.label}>
          {s.key === 'gmail' && (
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
          )}
          {s.key === 'github' && (
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .3.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" /></svg>
          )}
          {s.key === 'linkedin' && (
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.55V9h3.57v11.45Z" /></svg>
          )}
          {s.key === 'x' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41Z" /></svg>
          )}
          <span class="social-text">{s.text}</span>
        </a>
      ))}
    </div>

    <div class="hero-actions" data-fade-late>
      <a class="btn btn-primary" href="#work">View the work <span class="link-arrow" aria-hidden="true">→</span></a>
      <a class="btn" href="#contact">Contact</a>
    </div>
  </div>
</section>

<script>
  // Stable-dimension rotator: phrases share one grid cell, so the box sizes
  // to the longest phrase once and never jumps. Crossfade only.
  const rotator = document.querySelector<HTMLElement>('[data-rotator]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (rotator && !reduce) {
    const phrases = Array.from(rotator.querySelectorAll<HTMLElement>('.rotator-phrase'));
    let list: string[] = [];
    try {
      list = JSON.parse(rotator.dataset.phrases || '[]');
    } catch {
      list = [];
    }
    let i = 0;
    const show = (next: number) => {
      i = next % phrases.length;
      phrases.forEach((p, idx) => {
        const active = idx === i;
        p.setAttribute('data-active', active ? 'true' : 'false');
        p.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      if (list[i]) rotator.setAttribute('aria-label', `Currently focused on: ${list[i]}`);
    };
    if (phrases.length > 1) {
      window.setInterval(() => show(i + 1), 3200);
    }
  } else if (rotator) {
    // Reduced motion: first phrase stays, rest hidden from AT.
    const phrases = Array.from(rotator.querySelectorAll<HTMLElement>('.rotator-phrase'));
    phrases.forEach((p, idx) => {
      p.setAttribute('data-active', idx === 0 ? 'true' : 'false');
      p.setAttribute('aria-hidden', idx === 0 ? 'false' : 'true');
    });
  }

  // Park the atmosphere when the hero scrolls away: one observer, no loops.
  const heroSection = document.querySelector<HTMLElement>('[data-hero]');
  if (heroSection && !reduce && 'IntersectionObserver' in window) {
    const calm = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          heroSection.setAttribute('data-calm', entry.isIntersecting ? 'false' : 'true');
        });
      },
      { threshold: 0 }
    );
    calm.observe(heroSection);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 96svh;
    display: flex;
    align-items: flex-end;
    padding: clamp(5.5rem, 11vw, 8.5rem) clamp(1.25rem, 5vw, 3.5rem) clamp(2.75rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    overflow: clip;
  }

  /* Atmospheric material: two whisper-soft warm fields drifting almost
     imperceptibly behind the type. Living material, not animation —
     paused offscreen, static on mobile, gone on reduced motion. */
  .hero-atmos {
    position: absolute;
    inset: 0;
    overflow: clip;
    pointer-events: none;
  }

  .hero-atmos span {
    position: absolute;
    display: block;
    will-change: transform;
  }

  .atmos-a {
    width: 44rem;
    height: 30rem;
    right: -10rem;
    top: -8rem;
    background: radial-gradient(closest-side, rgba(150, 105, 15, 0.075), transparent 72%);
    animation: atmos-drift 26s ease-in-out infinite alternate;
  }

  .atmos-b {
    width: 36rem;
    height: 26rem;
    left: -12rem;
    bottom: -10rem;
    background: radial-gradient(closest-side, rgba(120, 110, 95, 0.09), transparent 72%);
    animation: atmos-drift 32s ease-in-out infinite alternate-reverse;
  }

  [data-theme='dark'] .atmos-a {
    background: radial-gradient(closest-side, rgba(217, 166, 72, 0.08), transparent 72%);
  }

  [data-theme='dark'] .atmos-b {
    background: radial-gradient(closest-side, rgba(120, 118, 112, 0.1), transparent 72%);
  }

  @keyframes atmos-drift {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-26px, 22px, 0); }
  }

  /* Paused the moment the hero leaves the viewport (JS toggles data-calm). */
  .hero[data-calm='true'] .hero-atmos span {
    animation-play-state: paused;
  }

  .hero-inner { max-width: 62rem; width: 100%; min-width: 0; position: relative; z-index: 1; }

  .hero-identity {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  /* Real photo only — no placeholder, no initials. The whole rule is
     dormant until a public/profile.* file exists. */
  .hero-avatar-img {
    width: 3.5rem;
    height: 3.5rem;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
  }

  .hero-name {
    margin: 0;
    font-size: var(--step-0);
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .hero-place {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  .hero-title {
    font-size: clamp(3rem, 9.5vw, 7rem);
    font-weight: 720;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 12ch;
    color: var(--ink);
  }

  .hero-permanent {
    margin-top: var(--space-xl);
    max-width: 42ch;
    font-size: clamp(1.02rem, 1.5vw, 1.22rem);
    line-height: 1.55;
    color: var(--ink-dim);
  }

  .hero-rotating {
    margin-top: var(--space-md);
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
    font-size: var(--step-0);
    color: var(--ink-faint);
  }

  .hero-rotating-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    flex: none;
  }

  /* Stable dimensions: all phrases share grid-area 1/1, so the container
     sizes to the longest phrase once. Opacity crossfade only. */
  .rotator {
    display: grid;
    min-height: 1.7em;
    min-width: min(22ch, 100%);
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .rotator-phrase {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.55s var(--ease), transform 0.55s var(--ease);
    pointer-events: none;
  }

  .rotator-phrase[data-active='true'] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .hero-social {
    margin-top: var(--space-xl);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink-dim);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    border-radius: 999px;
    padding: 0.5rem 0.9rem 0.5rem 0.7rem;
    font-size: var(--step--1);
    transition: opacity 0.22s var(--ease-out), transform 0.22s var(--ease-out), border-color 0.22s var(--ease-out), color 0.22s var(--ease-out);
  }

  .social-link:hover {
    opacity: 0.88;
    transform: translateY(-1px) scale(1.03);
    border-color: var(--line-strong);
    color: var(--ink);
  }

  .social-link:active { transform: scale(0.98); }

  .social-text { letter-spacing: 0.01em; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: var(--space-lg);
  }

  .btn {
    font-size: var(--step--1);
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--ink-dim);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 0.65rem 1.15rem;
    background: transparent;
    transition: color 0.22s var(--ease-out), border-color 0.22s var(--ease-out), background-color 0.22s var(--ease-out), transform 0.15s ease;
  }

  .btn:hover { color: var(--ink); border-color: var(--ink-faint); }
  .btn-primary { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .btn-primary:hover { color: var(--bg); opacity: 0.9; border-color: var(--ink); }

  @media (max-width: 640px) {
    .hero { min-height: 88svh; }
    .hero-title { letter-spacing: -0.025em; }
    .rotator { min-width: 100%; }
    .social-link { padding: 0.55rem 0.85rem; }
    /* Mobile: one static field, no drift — intentional, cheaper. */
    .atmos-a { animation: none; opacity: 0.7; }
    .atmos-b { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rotator-phrase { transition: none; }
    .hero-atmos { display: none; }
  }
</style>
