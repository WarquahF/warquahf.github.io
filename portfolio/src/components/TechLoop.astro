---
// Static tool list, honest and plain: no looping marquee, no ratings.
// Same list as before, just not animated.
const groups: { label: string; items: string[] }[] = [
  { label: 'Languages', items: ['Odin', 'Rust', 'C++', 'Python', 'JavaScript', 'TypeScript'] },
  { label: 'Web', items: ['HTML', 'CSS'] },
  { label: 'Tooling', items: ['Git', 'GitHub', 'Docker', 'Kubernetes'] },
];
---

<section class="section stack" id="stack" aria-labelledby="stack-title">
  <div class="section-inner">
    <p class="eyebrow"><span class="path">/stack</span></p>
    <h2 id="stack-title" data-entrance>Tools I actually use.</h2>
    <p class="stack-lede" data-reveal>No ratings, no bars — just the languages and platforms behind the work above.</p>
    <div class="stack-groups" data-reveal>
      {groups.map((g) => (
        <div class="stack-group">
          <p class="stack-label mono">{g.label}</p>
          <p class="stack-items mono">{g.items.join(' · ')}</p>
        </div>
      ))}
    </div>
    <p class="stack-hint mono" data-reveal>Tauri · SQLite · Electron · Ollama · OpenRouter — as used in Blink and Zest-TTY.</p>
  </div>
</section>

<style>
  .stack-title { max-width: 18ch; }
  .stack-lede { margin-top: var(--space-sm); max-width: 52ch; }
  .stack-groups { margin-top: var(--space-lg); display: grid; gap: var(--space-sm); }
  .stack-group { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; align-items: baseline; }
  .stack-label { font-size: 0.78rem; opacity: 0.55; min-width: 7ch; }
  .stack-items { font-size: 0.92rem; }
</style>
