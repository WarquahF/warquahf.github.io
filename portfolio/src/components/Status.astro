---
const focus = ['Systems', 'Rust', 'Desktop Applications', 'Frontend Engineering'];
---

<section class="section" id="status" data-reveal>
  <div class="section-inner">
    <p class="eyebrow"><span class="path">/status</span></p>
    <h2 data-entrance>Currently building</h2>

    <div class="status-grid" data-scale-in>
      <div class="status-block">
        <p class="mono status-label">Building</p>
        <p class="text-ink status-value">Blink</p>
        <p class="status-sub">Local-first AI assistant · Tauri migration</p>
        <p class="mono status-commit">Source is private while it's in progress. Write-ups and notes are public</p>
      </div>

      <div class="status-block">
        <p class="mono status-label">Stack</p>
        <p class="mono status-stack">Tauri · Rust · TypeScript · SQLite</p>
      </div>

      <div class="status-block">
        <p class="mono status-label">Focus</p>
        <ul class="status-focus mono">
          {focus.map((f, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{f}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .status-grid {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  @media (max-width: 780px) {
    .status-grid {
      grid-template-columns: 1fr;
    }
  }

  .status-block {
    background: var(--bg);
    padding: var(--space-lg);
  }

  .status-label {
    font-size: var(--step--2);
    color: var(--signal);
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-md);
  }

  .status-value {
    font-family: var(--font-display);
    font-size: var(--step-2);
    margin: 0;
    line-height: 1.2;
  }

  .status-sub {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--ink-dim);
    line-height: 1.5;
  }

  .status-commit {
    margin-top: var(--space-sm);
    font-size: var(--step--2);
    color: var(--ink-faint);
    line-height: 1.5;
  }

  .status-stack {
    color: var(--ink-dim);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .status-focus {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .status-focus li {
    display: flex;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  .status-focus li span {
    color: var(--ink-faint);
  }
</style>
