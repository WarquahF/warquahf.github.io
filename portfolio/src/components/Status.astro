---
const focus = ['Systems', 'Rust', 'Desktop Applications', 'Frontend Engineering'];

let lastCommit: { when: string; message: string } | null = null;
try {
  const res = await fetch('https://api.github.com/repos/WarquahF/Blink/commits/main', {
    headers: { Accept: 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data = await res.json();
    const date = new Date(data.commit.author.date);
    const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
    const units: [number, string][] = [
      [60, 'second'],
      [60, 'minute'],
      [24, 'hour'],
      [30, 'day'],
      [12, 'month'],
    ];
    let value = seconds;
    let unit = 'second';
    for (const [size, name] of units) {
      if (Math.abs(value) < size) break;
      value = Math.round(value / size);
      unit = name;
    }
    lastCommit = {
      when: `${value} ${unit}${Math.abs(value) === 1 ? '' : 's'} ago`,
      message:
        data.commit.message.split('\n')[0].slice(0, 60) +
        (data.commit.message.length > 60 ? '…' : ''),
    };
  }
} catch {
  // Network failure, rate limit, unknown repo — render nothing.
}
---

<section class="section" id="status" data-reveal>
  <div class="section-inner">
    <p class="eyebrow"><span class="path">/status</span></p>
    <h2 data-entrance>Currently building</h2>

    <div class="status-grid" data-scale-in>
      <div class="status-block">
        <p class="mono status-label">Building</p>
        <p class="text-ink status-value">Blink</p>
        <p class="status-sub">Local-first AI assistant · Tauri migration</p>
        {lastCommit && (
          <p class="mono status-commit">Last commit — {lastCommit.when} — {lastCommit.message}</p>
        )}
      </div>

      <div class="status-block">
        <p class="mono status-label">Stack</p>
        <p class="mono status-stack">Tauri · Rust · TypeScript · SQLite</p>
      </div>

      <div class="status-block">
        <p class="mono status-label">Focus</p>
        <ul class="status-focus mono">
          {focus.map((f, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{f}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .status-grid {
    margin-top: var(--space-xl);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  @media (max-width: 780px) {
    .status-grid {
      grid-template-columns: 1fr;
    }
  }

  .status-block {
    background: var(--bg);
    padding: var(--space-lg);
  }

  .status-label {
    font-size: var(--step--2);
    color: var(--signal);
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-md);
  }

  .status-value {
    font-family: var(--font-display);
    font-size: var(--step-2);
    margin: 0;
    line-height: 1.2;
  }

  .status-sub {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--ink-dim);
    line-height: 1.5;
  }

  .status-commit {
    margin-top: var(--space-sm);
    font-size: var(--step--2);
    color: var(--ink-faint);
    line-height: 1.5;
  }

  .status-stack {
    color: var(--ink-dim);
    font-size: var(--step-0);
    line-height: 1.5;
  }

  .status-focus {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .status-focus li {
    display: flex;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--ink-dim);
  }

  .status-focus li span {
    color: var(--ink-faint);
  }
</style>
