---
import { social } from '../data/nav';
---

<section class="section" id="contact" aria-labelledby="contact-title" data-reveal style="border-bottom: none;">
  <div class="section-inner container">
    <p class="eyebrow"><span class="path">/contact</span></p>
    <h2 id="contact-title" data-entrance>Get in touch</h2>
    <p style="margin-top: 0.75rem;">
      Open to projects, collaborations and conversations about software
      and systems.
    </p>

    <div class="contact-links mono">
      <a href={social.github} target="_blank" rel="noreferrer">
        <span class="contact-label">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.15c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.53-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .3.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" /></svg>
          GitHub
        </span>
        <span class="contact-value">github.com/WarquahF</span>
      </a>
      <div class="contact-row">
        <a class="contact-main" href={`mailto:${social.email}`}>
          <span class="contact-label">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
            Email
          </span>
          <span class="contact-value">{social.email}</span>
        </a>
        <button
          type="button"
          class="copy-btn mono"
          data-copy={social.email}
          aria-label={`Copy email address ${social.email}`}
        >
          <span data-copy-label>Copy</span>
        </button>
        <span class="copy-status mono" data-copy-status role="status" aria-live="polite"></span>
      </div>
      <a href={social.x} target="_blank" rel="noreferrer">
        <span class="contact-label">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41Z" /></svg>
          X
        </span>
        <span class="contact-value">@warquah35</span>
      </a>
    </div>

    <p class="contact-note mono">Prefer async? Email works best — I usually reply within 24 hours.</p>
  </div>
</section>

<script>
  // Copy-email: clipboard API with a textarea fallback, short success state,
  // plain failure state. The mailto link sits right beside it as the manual
  // next action, so nothing is ever a dead end.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = document.querySelector<HTMLElement>('[data-copy-label]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  let timer = 0;

  const showState = (ok: boolean) => {
    if (!btn || !label || !status) return;
    window.clearTimeout(timer);
    btn.setAttribute('data-done', ok ? 'true' : 'false');
    label.textContent = ok ? 'Copied' : 'Copy';
    status.textContent = ok ? 'Copied' : 'Copy failed — use the link';
    timer = window.setTimeout(() => {
      btn.setAttribute('data-done', 'false');
      if (label) label.textContent = 'Copy';
      if (status) status.textContent = '';
    }, 1800);
  };

  const legacyCopy = (text: string): boolean => {
    try {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    } catch {
      return false;
    }
  };

  btn?.addEventListener('click', async () => {
    const text = btn.getAttribute('data-copy') ?? '';
    if (!text) return;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(text);
        showState(true);
      } else {
        showState(legacyCopy(text));
      }
    } catch {
      showState(legacyCopy(text));
    }
  });
</script>

<style>
  .contact-links {
    margin-top: var(--space-xl);
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .contact-links a,
  .contact-row {
    border-bottom: 1px solid var(--line);
  }

  .contact-links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem var(--space-2xs);
    text-decoration: none;
    transition: padding-left 0.25s var(--ease-out), color 0.2s var(--ease-out);
    color: var(--ink-dim);
  }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem var(--space-2xs);
  }

  .contact-main {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.4rem 0;
    text-decoration: none;
    transition: padding-left 0.25s var(--ease-out), color 0.2s var(--ease-out);
    color: var(--ink-dim);
  }

  .contact-links a:hover,
  .contact-row:hover .contact-main {
    padding-left: 0.6rem;
    color: var(--ink);
  }

  .copy-btn {
    flex: none;
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    background: var(--bg-raised);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out), opacity 0.2s ease;
  }

  .copy-btn:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }

  .copy-btn[data-done='true'] {
    color: var(--go);
    border-color: var(--go);
  }

  .copy-status {
    flex: none;
    min-width: 3.2rem;
    font-size: var(--step--2);
    color: var(--ink-faint);
  }

  .contact-label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--step--1);
    color: var(--ink-faint);
    flex: none;
  }

  .contact-label svg {
    flex: none;
    opacity: 0.85;
  }

  .contact-value {
    font-size: var(--step--1);
    text-align: right;
    overflow-wrap: anywhere;
    transition: color 0.2s var(--ease-out);
  }

  .contact-links a:hover .contact-value,
  .contact-row:hover .contact-value {
    color: var(--ink);
  }

  .contact-note {
    margin-top: var(--space-lg);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
