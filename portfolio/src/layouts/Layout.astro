---
import '../styles/global.css';
import CommandPalette from '../components/svelte/CommandPalette.svelte';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Warquah Faiz — Software Developer',
  description = 'Warquah Faiz — building local-first desktop software and developer tools. Blink, Zest-TTY, Nugget.',
} = Astro.props;

// Rail ruler: 19 ticks, the 4 majors double as section links.
const TICK_COUNT = 19;
const majorTickFor = [0, 6, 12, 18];
const rail = [
  { label: 'ABOUT', href: '#about' },
  { label: 'WORK', href: '#work' },
  { label: 'STACK', href: '#stack' },
  { label: 'CONTACT', href: '#contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#faf8f3" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('wf-theme') || 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.site && (
      <>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="gutter-shell" id="home">
      <aside class="rail" aria-label="Section index">
        <p class="rail-label" aria-hidden="true">Index</p>
        <nav class="rail-scale" aria-label="Sections">
          {Array.from({ length: TICK_COUNT }, (_, i) => {
            const si = majorTickFor.indexOf(i);
            return si === -1 ? (
              <span class="tick" data-tick={i} aria-hidden="true"></span>
            ) : (
              <a
                class="tick tick-major"
                href={rail[si].href}
                data-target={rail[si].href}
                data-active="false"
                data-tick={i}
                aria-label={rail[si].label}
                data-label={rail[si].label}
              >
                <span class="tick-label" aria-hidden="true">{rail[si].label}</span>
              </a>
            );
          })}
        </nav>
        <p class="rail-foot" aria-hidden="true">WF — 2026</p>
      </aside>

      <main id="main">
        <slot />
      </main>
    </div>

    <CommandPalette client:idle />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---- Scroll zoom: sections below the hero scale from 0.94 -> 1 as
      // ---- they scroll into the middle band of the viewport (skydive-style
      // ---- gentle zoom-in). One rAF loop, transform+opacity only.
      const zoomEls = Array.from(document.querySelectorAll<HTMLElement>('#main > section, #main > div[data-zoomzone]'));
      if (!reduceMotion && zoomEls.length) {
        // skip the first (hero) and tag the rest
        zoomEls.slice(1).forEach((el) => el.setAttribute('data-zoom', ''));
        let zoomRaf = 0;
        const updateZoom = () => {
          zoomRaf = 0;
          const vh = window.innerHeight;
          for (const el of zoomEls) {
            if (!el.hasAttribute('data-zoom')) continue;
            const r = el.getBoundingClientRect();
            // progress 0 when the section top hits the bottom of the viewport,
            // 1 when its top reaches 40% down the viewport.
            const t = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.6)));
            el.style.setProperty('--zoom', t.toFixed(3));
          }
        };
        window.addEventListener('scroll', () => { if (!zoomRaf) zoomRaf = requestAnimationFrame(updateZoom); }, { passive: true });
        window.addEventListener('resize', () => { if (!zoomRaf) zoomRaf = requestAnimationFrame(updateZoom); }, { passive: true });
        updateZoom();
      }

      // ---- Left rail: a tick ruler that reacts to scroll. Ticks near the
      // ---- playhead extend and brighten; the major tick of the section in
      // ---- view locks to full ink. Majors are real links (see markup).
      const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.tick-major'));
      const ticks = Array.from(document.querySelectorAll<HTMLElement>('[data-tick]'));
      const TICK_MAX = Math.max(1, ticks.length - 1);
      const targets = links
        .map((link) => {
          const id = link.dataset.target?.replace('#', '');
          const el = id ? document.getElementById(id) : null;
          return el ? { link, el } : null;
        })
        .filter((v): v is { link: HTMLAnchorElement; el: HTMLElement } => v !== null);

      const setActiveStop = (active: { link: HTMLAnchorElement; el: HTMLElement } | null) => {
        targets.forEach((t) => {
          const on = t === active;
          t.link.setAttribute('data-active', on ? 'true' : 'false');
          if (on) {
            t.link.setAttribute('aria-current', 'true');
          } else {
            t.link.removeAttribute('aria-current');
          }
        });
      };

      if (targets.length && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const match = targets.find((t) => t.el === entry.target);
              if (!match) return;
              if (entry.isIntersecting) setActiveStop(match);
            });
          },
          { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
        );
        targets.forEach((t) => observer.observe(t.el));
      } else if (targets.length) {
        setActiveStop(targets[0] ?? null);
      }

      // Ticks breathe with the page: passed ticks stay dimly lit, ticks
      // near the playhead extend to full. Transform + opacity only.
      const paintTicks = (p: number) => {
        ticks.forEach((el) => {
          const t = Number(el.dataset.tick ?? 0) / TICK_MAX;
          const d = Math.abs(p - t);
          const near = Math.max(0, 1 - d / 0.14);
          const passed = p >= t ? 0.55 : 0;
          const boost = el.getAttribute('data-active') === 'true' ? 0.3 : 0;
          const v = Math.min(1, 0.3 + 0.7 * Math.max(passed, near) + boost);
          el.style.transform = `scaleX(${v.toFixed(3)})`;
          el.style.opacity = `${(0.35 + 0.65 * Math.min(1, Math.max(passed, near) + boost)).toFixed(3)}`;
        });
      };

      // Smooth scroll from the rail (native, motion-safe).
      links.forEach((link) => {
        link.addEventListener('click', (e) => {
          const id = link.getAttribute('href');
          if (!id?.startsWith('#')) return;
          const target = document.querySelector(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          history.replaceState(null, '', id);
          (target as HTMLElement).setAttribute('tabindex', '-1');
        });
      });

      // ---- One calm reveal language: fade + rise once, then stay. --------
      const revealEls = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal], [data-scale-in]')
      );
      if (reduceMotion || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-in'));
      } else if (revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      }

      // Word-mask entrances: split once, reveal with a short understated
      // stagger via per-word CSS delay (35ms each, capped at 280ms).
      document.querySelectorAll<HTMLElement>('[data-entrance]').forEach((el) => {
        if (el.dataset.split === 'done') return;
        const words = el.textContent?.split(/\s+/).filter(Boolean) ?? [];
        const label = words.join(' ');
        el.setAttribute('aria-label', label);
        el.innerHTML = words
          .map((w, i) => `<span class="w"><span style="transition-delay:${Math.min(i * 35, 280)}ms">${w}</span></span>`)
          .join(' ');
        el.dataset.split = 'done';
      });

      const entranceEls = Array.from(document.querySelectorAll<HTMLElement>('[data-entrance]'));
      if (reduceMotion || !('IntersectionObserver' in window)) {
        entranceEls.forEach((el) => el.classList.add('is-in'));
      } else if (entranceEls.length) {
        const eio = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                eio.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.4 }
        );
        entranceEls.forEach((el) => eio.observe(el));
      }

      // Viewport-triggered phrase emphasis: muted until the phrase crosses
      // the middle band, then stays emphasized. Discrete events only.
      document.querySelectorAll<HTMLElement>('[data-trigger-highlight]').forEach((el) => {
        if (el.dataset.split === 'done') return;
        const full = el.textContent ?? '';
        el.setAttribute('aria-label', full.split('|').join(' ').replace(/\s+/g, ' ').trim());
        el.innerHTML = full
          .split('|')
          .map((part) => part.trim())
          .filter(Boolean)
          .map(
            (phrase) =>
              `<span class="tph">${phrase
                .split(/\s+/)
                .map((w) => `<span class="tw">${w}</span>`)
                .join(' ')}</span>`
          )
          .join(' ');
        el.dataset.split = 'done';
      });

      const phrases = Array.from(document.querySelectorAll<HTMLElement>('.tph'));
      if (reduceMotion || !('IntersectionObserver' in window)) {
        phrases.forEach((p) => p.classList.add('lit'));
        document.querySelectorAll('[data-highlight] .hw').forEach((w) => w.classList.add('lit'));
      } else if (phrases.length) {
        const pio = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('lit');
                pio.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '-42% 0px -42% 0px', threshold: 0 }
        );
        phrases.forEach((p) => pio.observe(p));
      }

      // Legacy scroll-lit statements: keep readable without a library —
      // light words progressively on scroll with rAF-throttled checks.
      const highlightBlocks = Array.from(document.querySelectorAll<HTMLElement>('[data-highlight]'));
      highlightBlocks.forEach((el) => {
        if (el.dataset.split === 'done') return;
        const words = el.textContent?.split(/\s+/).filter(Boolean) ?? [];
        const label = words.join(' ');
        el.innerHTML = words.map((w) => `<span class="hw">${w}</span>`).join(' ');
        el.setAttribute('aria-label', label);
        el.dataset.split = 'done';
      });
      if (!reduceMotion && highlightBlocks.length) {
        let ticking = false;
        const paint = () => {
          ticking = false;
          highlightBlocks.forEach((el) => {
            const spans = Array.from(el.querySelectorAll('.hw'));
            if (!spans.length) return;
            const r = el.getBoundingClientRect();
            const vh = window.innerHeight || 800;
            // Progress of the block through the viewport, eased at ends.
            const total = r.height + vh;
            const passed = vh - r.top;
            const raw = Math.min(1, Math.max(0, passed / total));
            const eased = Math.min(1, Math.max(0, (raw - 0.25) / 0.5));
            const count = Math.floor(eased * (spans.length + 1));
            spans.forEach((s, i) => s.classList.toggle('lit', i < count));
          });
        };
        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(paint);
          }
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        paint();
      } else {
        document.querySelectorAll('[data-highlight] .hw').forEach((w) => w.classList.add('lit'));
      }

      // Scroll progress hairline + rail ticks: one rAF-throttled listener.
      const progress = document.querySelector<HTMLElement>('.progress');
      if (progress || ticks.length) {
        let pticking = false;
        const paintProgress = () => {
          pticking = false;
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          if (progress) progress.style.transform = `scaleX(${p})`;
          if (ticks.length) paintTicks(p);
        };
        const onPScroll = () => {
          if (!pticking) {
            pticking = true;
            requestAnimationFrame(paintProgress);
          }
        };
        window.addEventListener('scroll', onPScroll, { passive: true });
        paintProgress();
      }

      // Nav: transparent at top, solid once scrolling.
      const nav = document.querySelector('.nav');
      let nticking = false;
      const paintNav = () => {
        nticking = false;
        nav?.classList.toggle('is-solid', window.scrollY > 24);
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!nticking) {
            nticking = true;
            requestAnimationFrame(paintNav);
          }
        },
        { passive: true }
      );
      paintNav();
    </script>

    <style is:global>
      .skip {
        position: fixed;
        top: -4rem;
        left: 1rem;
        z-index: 200;
        background: var(--ink);
        color: var(--bg);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        padding: 0.6rem 1rem;
        border-radius: 4px;
        text-decoration: none;
        transition: top 0.2s ease;
      }
      .skip:focus { top: 1rem; }
    </style>
  </body>
</html>
