/* Theme toggle + transition ripple */
.head-side{display:flex;align-items:center;gap:26px}
.theme-toggle{display:none;position:relative;width:44px;height:44px;border:1px solid var(--line);border-radius:50%;background:transparent;color:var(--ink);cursor:pointer;align-items:center;justify-content:center;transition:border-color .25s}
html.js .theme-toggle{display:flex}
.theme-toggle:hover{border-color:var(--ink)}
.theme-toggle-solo{position:fixed;top:16px;right:20px;z-index:60;background:color-mix(in srgb,var(--paper) 70%,transparent);-webkit-backdrop-filter:blur(10px) saturate(1.2);backdrop-filter:blur(10px) saturate(1.2)}
.theme-toggle svg{position:absolute;width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;transition:opacity .35s,rotate .5s cubic-bezier(.16,1,.3,1),scale .35s}
.theme-toggle .i-moon{opacity:0;rotate:-90deg;scale:.5}
[data-theme='dark'] .theme-toggle .i-sun{opacity:0;rotate:90deg;scale:.5}
[data-theme='dark'] .theme-toggle .i-moon{opacity:1;rotate:0deg;scale:1}
.theme-ripple{position:fixed;inset:0;z-index:60;pointer-events:none}
/* GitHub activity */
.activity{display:grid;grid-template-columns:.75fr 1.25fr;gap:70px;padding:36px 0 0;margin-top:44px;border-top:1px solid var(--line)}
.activity .mono{color:var(--muted)}
.activity-total{margin:0 0 20px;font-size:15px;color:var(--muted)}
.activity-total strong{display:block;font:normal clamp(44px,6vw,68px)/1 var(--serif);letter-spacing:-.045em;color:var(--ink);margin-bottom:8px}
.gh-cal{display:flex;gap:3px;overflow-x:auto;padding:6px;background:var(--paper);border-radius:6px}
.gh-week{display:flex;flex-direction:column;gap:3px}
.gh-cell{width:10px;height:10px;border-radius:2px;background:#e6e8ee}
.gh-cell.l1{background:#9be9a8}
.gh-cell.l2{background:#40c463}
.gh-cell.l3{background:#30a14e}
.gh-cell.l4{background:#216e39}
[data-theme='dark'] .gh-cell{background:#2a2f3a}
[data-theme='dark'] .gh-cell.l1{background:#0e4429}
[data-theme='dark'] .gh-cell.l2{background:#006d32}
[data-theme='dark'] .gh-cell.l3{background:#26a641}
[data-theme='dark'] .gh-cell.l4{background:#39d353}
.activity-foot{margin:14px 0 0;font-size:11px}
.activity-foot a{border-bottom:1px solid var(--muted);color:var(--muted)}
.activity-foot a:hover{color:var(--blue);border-color:var(--blue)}
@media(max-width:850px){.activity{gap:35px}}
@media(max-width:600px){.activity{grid-template-columns:1fr;gap:15px;padding-top:24px;margin-top:30px}.head-side{gap:14px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{animation:none!important;transition:none!important}}
/* Folder: editorial overrides to match the site identity */
#folder{display:flex;justify-content:center;padding:48px 0 72px}
.folder-doc-title{font:15px/1.3 var(--sans);letter-spacing:-.01em}
.folder-doc-text{font:10px/1.5 var(--sans)}
</style>
