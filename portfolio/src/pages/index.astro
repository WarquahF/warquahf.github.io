 function apply(t){
  root.dataset.theme=t;
  try{localStorage.setItem('wf-theme',t);}catch(e){}
  if(meta)meta.setAttribute('content',colors[t]);
  var dark=t==='dark';
  btn.setAttribute('aria-pressed',dark?'true':'false');
  btn.setAttribute('aria-label',dark?'Switch to light theme':'Switch to dark theme');
 }
 apply(root.dataset.theme==='dark'?'dark':'light');
 btn.addEventListener('click',function(){
  var next=root.dataset.theme==='dark'?'light':'dark';
  if(reduce){apply(next);return;}
  var r=btn.getBoundingClientRect();
  var x=Math.round(r.left+r.width/2),y=Math.round(r.top+r.height/2);
  var maxR=Math.ceil(Math.hypot(Math.max(x,window.innerWidth-x),Math.max(y,window.innerHeight-y)));
  var rip=document.createElement('div');
  rip.className='theme-ripple';
  rip.style.background=colors[next];
  rip.style.clipPath='circle(0px at '+x+'px '+y+'px)';
  document.body.appendChild(rip);
  var anim=rip.animate(
   [{clipPath:'circle(0px at '+x+'px '+y+'px)'},{clipPath:'circle('+maxR+'px at '+x+'px '+y+'px)'}],
   {duration:650,easing:'cubic-bezier(.4,0,.2,1)',fill:'forwards'});
  anim.onfinish=function(){
   apply(next);
   var fade=rip.animate([{opacity:1},{opacity:0}],{duration:280,easing:'ease-out',fill:'forwards'});
   fade.onfinish=function(){rip.remove();};
  };
 });
})();
</script>
<script is:inline>
/* Delight layer: letter splitting for choreography, magnetic hero buttons,
   specimen tilt, calendar cascade index. Enhancement only: skipped under
   reduced-motion, and the page renders fully without it. */
(function(){
 var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 if(reduce)return;
 function split(el){
  var n=0;
  function walk(node){
   [].slice.call(node.childNodes).forEach(function(k){
    if(k.nodeType===3){
     var frag=document.createDocumentFragment(),text=k.textContent;
     for(var i=0;i<text.length;i++){
      var ch=text[i];
      if(ch===' '){frag.appendChild(document.createTextNode(' '));continue;}
      var sp=document.createElement('span');
      sp.className='ltr';sp.style.setProperty('--n',n++);sp.textContent=ch;
      frag.appendChild(sp);
     }
     node.replaceChild(frag,k);
    }else if(k.nodeType===1&&k.tagName!=='BR'){walk(k);}
   });
  }
  walk(el);
 }
 var name=document.getElementById('name');
 if(name){
  name.setAttribute('aria-label',name.textContent.replace(/\s+/g,' ').trim());
  [].slice.call(name.querySelectorAll('.line-in')).forEach(function(l){l.setAttribute('aria-hidden','true');split(l);});
 }
 [].slice.call(document.querySelectorAll('.project h3,.writing-intro,.contact h2')).forEach(split);
 [].slice.call(document.querySelectorAll('.gh-week')).forEach(function(w,i){w.style.setProperty('--i',i);});
 if(window.matchMedia&&window.matchMedia('(hover:hover) and (pointer:fine)').matches){
  var magnets=[].slice.call(document.querySelectorAll('.float-btn svg'));
  if(magnets.length){
   magnets.forEach(function(svg){svg.style.transition='transform .35s cubic-bezier(.16,1,.3,1)';});
   var raf=null;
   document.addEventListener('pointermove',function(e){
    if(raf)return;
    raf=requestAnimationFrame(function(){
     raf=null;
     magnets.forEach(function(svg){
      var b=svg.getBoundingClientRect();
      var dx=e.clientX-(b.left+b.width/2),dy=e.clientY-(b.top+b.height/2);
      var d=Math.hypot(dx,dy);
      if(d<110&&d>0.01){var f=(1-d/110)*9;svg.style.transform='translate('+(dx/d*f).toFixed(1)+'px,'+(dy/d*f).toFixed(1)+'px)';}
      else{svg.style.transform='';}
     });
    });
   },{passive:true});
  }
  [].slice.call(document.querySelectorAll('.specimen')).forEach(function(card){
   card.addEventListener('pointermove',function(e){
    var r=card.getBoundingClientRect();
    var px=(e.clientX-r.left)/r.width-0.5,py=(e.clientY-r.top)/r.height-0.5;
    card.style.transform='rotateY('+(px*6).toFixed(2)+'deg) rotateX('+(-py*6).toFixed(2)+'deg)';
   });
   card.addEventListener('pointerleave',function(){card.style.transform='';});
  });
 }
 /* press d to flip the theme - same path as the toggle button */
 document.addEventListener('keydown',function(e){
  if(e.key!=='d'&&e.key!=='D')return;
  if(e.metaKey||e.ctrlKey||e.altKey)return;
  var t=e.target;
  if(t&&(t.tagName==='INPUT'||t.tagName==='TEXTAREA'||t.isContentEditable))return;
  var b=document.getElementById('theme-toggle');
  if(b)b.click();
 });
 try{
  console.log('%c      ( (\n       ) )\n    ........\n    |      |]\n    \\      /\n     `----`','font-family:monospace');
  console.log('you found the console. source: https://github.com/WarquahF/warquahf.github.io');
 }catch(e){}
})();
</script>
<script is:inline>
/* Effects adapted from React Bits (reactbits.dev), vanilla JS, no dependencies:
   DecryptedText (/text-animations/decrypted-text) scrambles the ~/dir labels in on scroll,
   TextType (/text-animations/text-type) types the intro line into the existing caret.
   Decorative; the page renders fully without them, and both stand down under reduced motion. */
(function(){
 var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 if(reduce)return;

 /* DecryptedText: sequential scramble reveal, glyph pool from the original. */
 (function(){
  var POOL='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!@#$%^&*()_+';
  var STEP=40,ITERS=5;
  function scramble(el){
   var text=el.dataset.plain,chars=Array.from(text),step=0;
   var iv=setInterval(function(){
    var revealed=Math.floor(step/ITERS),out='';
    for(var i=0;i<chars.length;i++){
     out+=(i<revealed||/\s/.test(chars[i]))?chars[i]:POOL[(Math.random()*POOL.length)|0];
    }
    el.textContent=out;
    step++;
    if(revealed>=chars.length){clearInterval(iv);el.textContent=text;}
   },STEP);
  }
  var els=[].slice.call(document.querySelectorAll('.dir'));
  if(!els.length)return;
  els.forEach(function(el){el.dataset.plain=el.textContent;el.setAttribute('aria-label',el.textContent);});
  var io=new IntersectionObserver(function(entries){
   entries.forEach(function(en){if(en.isIntersecting){io.unobserve(en.target);scramble(en.target);}});
  },{threshold:0.4});
  els.forEach(function(el){io.observe(el);});
 })();

 /* TextType: typewriter into the intro line, preserving the line break and caret. */
 (function(){
  var p=document.querySelector('.intro-bottom p');
  if(!p)return;
  var caret=p.querySelector('.caret');
  var parts=[];
  [].slice.call(p.childNodes).forEach(function(n){
   if(n.nodeType===3)parts.push(n.textContent);
   else if(n.tagName==='BR')parts.push('\n');
  });
  var flat=parts.join('');
  [].slice.call(p.childNodes).forEach(function(n){if(n!==caret)p.removeChild(n);});
  var i=0,node=null;
  setTimeout(function(){
   var iv=setInterval(function(){
    if(i>=flat.length){clearInterval(iv);return;}
    var ch=flat[i++];
    if(ch==='\n'){p.insertBefore(document.createElement('br'),caret);node=null;}
    else{
     if(!node){node=document.createTextNode('');p.insertBefore(node,caret);}
     node.textContent+=ch;
    }
   },55);
  },650);
 })();
})();
</script>
