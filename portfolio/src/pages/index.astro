// GitHub contribution calendar: fetched at build time from the public
// contributions page, no token needed. Real data only - if the fetch or
// parse fails, the section falls back to a plain profile link.
const ghUser = 'WarquahF';
type GhDay = { date: string; count: number; level: number };
let ghTotal = 0;
let ghWeeks: GhDay[][] = [];
try {
  const res = await fetch(`https://github.com/users/${ghUser}/contributions`);
  if (!res.ok) throw new Error(`contributions page ${res.status}`);
  const html = await res.text();
  const totalMatch = html.match(/js-contribution-activity-description[^>]*>\s*([\d,]+)/);
  const counts = new Map<string, number>();
  for (const m of html.matchAll(/for="(contribution-day-component-[^"]+)"[^>]*>\s*(\d+|No) contribution/g)) {
    counts.set(m[1], m[2] === 'No' ? 0 : parseInt(m[2], 10));
  }
  const weeks = new Map<number, { d: number; day: GhDay }[]>();
  for (const m of html.matchAll(/data-date="(\d{4}-\d{2}-\d{2})"\s+id="(contribution-day-component-(\d+)-(\d+))"\s+data-level="(\d)"/g)) {
    // component id is <dayOfWeek>-<weekColumn>: group by column, order by row
    const day: GhDay = { date: m[1], count: counts.get(m[2]) ?? 0, level: parseInt(m[5], 10) };
    const wk = parseInt(m[4], 10);
    if (!weeks.has(wk)) weeks.set(wk, []);
    weeks.get(wk)!.push({ d: parseInt(m[3], 10), day });
  }
  ghWeeks = [...weeks.entries()]
    .sort((a, b) => a[0] - b[0])
    .map(([, days]) => days.sort((a, b) => a.d - b.d).map((x) => x.day));
  if (ghWeeks.length) {
    ghTotal = totalMatch
      ? parseInt(totalMatch[1].replace(/,/g, ''), 10)
      : ghWeeks.flat().reduce((n, d) => n + d.count, 0);
  }
} catch {
  // offline build or markup change: section renders the fallback link
}
